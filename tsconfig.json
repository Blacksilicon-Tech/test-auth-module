
{
  "compilerOptions": {
    /* 🔥 ESM / Node compatibility */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    /* 🎯 Output */
    "target": "ES2022",
    "outDir": "./dist",
    "sourceMap": true,

    /* 🧠 Decorators (NestJS required) */
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    /* 🧩 Interop + imports */
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    /* 🧹 Build quality */
    "declaration": false,
    "removeComments": false,
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,

    /* 🗺️ Paths */
    "baseUrl": "./"
  },
  "ts-node": {
    "esm": true
  }
}